{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryoku.example/schema/store-product-v1.json",
  "title": "RyoStore product v1",
  "type": "object",
  "required": ["schema", "id", "category", "version", "destination", "files"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "category": {"enum": ["rices", "lockscreens", "barstyles", "fastfetch", "plugins", "bundles", "decors", "launcher-images", "fastfetch-emblems", "ryotunes-skins"]},
    "version": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "destination", "mode", "size", "sha256", "install"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "destination": {"type": "string", "minLength": 1},
          "mode": {"enum": ["0644", "0755"]},
          "size": {"type": "integer", "minimum": 0, "maximum": 268435456},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "install": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "registryEntry": {
      "type": "object",
      "required": ["id", "name", "version", "path", "author", "summary", "description", "tags", "accent", "surface", "preview", "screenshots", "manifest", "manifestSha256"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "surface": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "preview": {"type": "string", "minLength": 1},
        "previewRaw": {"type": "string", "minLength": 1},
        "screenshots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manifest": {"type": "string", "minLength": 1},
        "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "downloadPaused": {"type": "boolean", "description": "Pause new downloads without delisting the item: the Store keeps it listed and removable and refuses install and update."},
        "downloadPauseReason": {"type": "string", "minLength": 1, "description": "User-facing note shown with a paused item."},
        "windowManager": {"type": "string", "minLength": 1, "description": "The window manager this item is written for, named the way `ryoku wm use <name>` names one (for example \"hyprland\"). Absent means it runs on any; on any other window manager the Store greys the item out and refuses the install."},
        "windowManagerReason": {"type": "string", "minLength": 1, "description": "User-facing note shown when the item cannot run on the current window manager."}
      }
    }
  }
}
