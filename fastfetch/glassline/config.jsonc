// Glassline
// Open precision rails: no rigid right edge for dynamic values to destroy.
// ryoku:recolor keys=primary title=foreground output=onSurface separator=outlineVariant
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 4
    }
  },

  "display": {
    "color": {
      "keys": "#9ccfd8",
      "title": "#e6e1dc",
      "output": "#c9c5c1",
      "separator": "#57535a"
    },
    "key": {
      "width": 13
    },
    "separator": "  "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#separator}╭─{#} {#1;title}{#}"
    },

    {
      "type": "os",
      "key": "│  os"
    },
    {
      "type": "kernel",
      "key": "│  kernel"
    },
    {
      "type": "uptime",
      "key": "│  uptime"
    },

    {
      "type": "custom",
      "format": "{#separator}├────────────────────────{#}"
    },

    {
      "type": "wm",
      "key": "│  desktop"
    },
    {
      "type": "shell",
      "key": "│  shell"
    },
    {
      "type": "terminal",
      "key": "│  terminal"
    },

    {
      "type": "custom",
      "format": "{#separator}├────────────────────────{#}"
    },

    {
      "type": "cpu",
      "key": "│  cpu"
    },
    {
      "type": "gpu",
      "key": "│  gpu",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "│  memory",
      "percent": {
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": "│  disk",
      "folders": "/",
      "percent": {
        "type": 9
      }
    },

    {
      "type": "custom",
      "format": "{#separator}╰────────────────────────{#}"
    }
  ]
}
