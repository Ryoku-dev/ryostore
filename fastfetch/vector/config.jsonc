// Vector
// Angular hardware-oriented readout.
// ryoku:recolor keys=primary title=foreground output=onSurface separator=secondary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 4
    }
  },

  "display": {
    "color": {
      "keys": "#dba4c4",
      "title": "#f0ebe8",
      "output": "#d1cac6",
      "separator": "#e2b596"
    },
    "key": {
      "width": 12
    },
    "separator": "  ▶  "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#keys}╱╱{#} {#1;title}{#}"
    },

    "break",

    {
      "type": "os",
      "key": "SYSTEM"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "percent": {
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": "STORAGE",
      "folders": "/",
      "percent": {
        "type": 9
      }
    },

    "break",

    {
      "type": "wm",
      "key": "COMPOSITOR"
    },
    {
      "type": "terminal",
      "key": "TERMINAL"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },

    "break"
  ]
}
