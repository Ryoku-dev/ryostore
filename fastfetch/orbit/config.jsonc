// Orbit
// Circular motifs around a compact everyday system summary.
// ryoku:recolor keys=primary title=foreground output=onSurface separator=secondary
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "color": {
      "keys": "#dda7c5",
      "title": "#f1eae7",
      "output": "#d2cac7",
      "separator": "#e2b595"
    },
    "key": {
      "width": 11
    },
    "separator": "  "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#keys}◎{#}  {#1;title}{#}"
    },

    "break",

    {
      "type": "os",
      "key": "○ SYSTEM"
    },
    {
      "type": "kernel",
      "key": "○ KERNEL"
    },
    {
      "type": "uptime",
      "key": "○ UPTIME"
    },

    "break",

    {
      "type": "cpu",
      "key": "◉ CPU"
    },
    {
      "type": "gpu",
      "key": "◉ GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "◉ MEMORY",
      "percent": {
        "type": 9
      }
    },

    "break",

    {
      "type": "wm",
      "key": "○ DESKTOP"
    },
    {
      "type": "terminal",
      "key": "○ TERMINAL"
    },
    {
      "type": "datetime",
      "key": "○ TIME"
    },

    "break",

    {
      "type": "custom",
      "format": "{#separator}○ ○ ○ {#keys}●{#} ○ ○ ○{#}"
    }
  ]
}
