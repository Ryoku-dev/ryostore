{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "90",
      "title": "97",
      "output": "39",
      "separator": "90"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "┌─────────────────Hardware─────────────────┐"
    },
    {
      "type": "cpu",
      "key": " ├─  ",
      "format": "{name:34}"
    },
    {
      "type": "gpu",
      "key": " ├─ 󰍛 ",
      "format": "{name:34}"
    },
    {
      "type": "memory",
      "key": " ├─ 󰘚 "
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌─────────────────Software─────────────────┐"
    },
    {
      "type": "os",
      "key": " ├─ 󰌽 ",
      "format": "{pretty-name:34}"
    },
    {
      "type": "kernel",
      "key": " ├─  ",
      "format": "{release:34}"
    },
    {
      "type": "wm",
      "key": " ├─ 󰨇 ",
      "format": "{pretty-name:34}"
    },
    {
      "type": "theme",
      "key": " ├─ 󰉼 ",
      "format": "{theme1:34}"
    },
    {
      "type": "icons",
      "key": " ├─ 󰀻 ",
      "format": "{icons1:34}"
    },
    {
      "type": "font",
      "key": " ├─ 󰛖 ",
      "format": "{font1:34}"
    },
    {
      "type": "terminal",
      "key": " ├─ 󰞷 ",
      "format": "{pretty-name:34}"
    },
    {
      "type": "shell",
      "key": " └─ 󰞷 ",
      "format": "{pretty-name:34}"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    }
  ]
}
