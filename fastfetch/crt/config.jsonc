// CRT
// Intentionally fixed phosphor green.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "data",
    "source": "$1 .-----------.\n|  /////////  |\n|  /////////  |\n|  /////////  |\n '-----------'\n      |_|",
    "color": {
      "1": "#7cff88"
    },
    "padding": {
      "right": 4
    }
  },

  "display": {
    "color": {
      "keys": "#7cff88",
      "title": "#b0ffb6",
      "output": "#8fe899",
      "separator": "#3d7843"
    },
    "key": {
      "width": 9
    },
    "separator": " > "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#1;title}://LOCAL{#}"
    },
    {
      "type": "custom",
      "format": "{#separator}................................{#}"
    },

    {
      "type": "os",
      "key": "SYS"
    },
    {
      "type": "kernel",
      "key": "KERN"
    },
    {
      "type": "wm",
      "key": "ENV"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEM"
    },
    {
      "type": "disk",
      "key": "DSK",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": "UP"
    },

    {
      "type": "custom",
      "format": "{#separator}................................{#}"
    },
    {
      "type": "datetime",
      "key": "TIME"
    },

    {
      "type": "custom",
      "format": "{#1;keys}> CURSOR ACTIVE_{#}"
    }
  ]
}
