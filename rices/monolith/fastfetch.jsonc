// MONOLITH
// Structural system readout for Ryoku.
// ANSI palette colours intentionally follow the terminal theme.
//
// ryoku:recolor keys=primary title=foreground separator=outline

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none"
  },

  "display": {
    "color": {
      "keys": "31",
      "title": "37",
      "output": "37",
      "separator": "90"
    },

    "key": {
      "width": 10
    },

    "separator": "  ",

    "percent": {
      "type": 9
    }
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "{#31}██{#}  {#1;title}MONOLITH{#}"
    },
    {
      "type": "custom",
      "format": "{#31}██{#}  {#separator}STRUCTURE / SYSTEM{#}"
    },
    {
      "type": "custom",
      "format": "{#31}██{#}"
    },
    {
      "type": "custom",
      "format": "{#31}██{#}  {#separator}────────────────────────────────────{#}"
    },

    "break",

    {
      "type": "custom",
      "format": "{#31}01{#}  {#1;title}VITALS{#}"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK"
    },

    "break",

    {
      "type": "custom",
      "format": "{#31}02{#}  {#1;title}SYSTEM{#}"
    },

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "packages",
      "key": "PACKAGES"
    },

    "break",

    {
      "type": "custom",
      "format": "{#31}03{#}  {#1;title}SESSION{#}"
    },

    {
      "type": "wm",
      "key": "DESKTOP"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "terminal",
      "key": "TERMINAL"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },

    "break",

    {
      "type": "custom",
      "format": "{#separator}────────────────────────────────────────{#}"
    },

    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },

    "break"
  ]
}
