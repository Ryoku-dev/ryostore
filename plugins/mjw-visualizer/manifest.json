{
  "id": "mjw-visualizer",
  "name": "Visualizer",
  "version": "2.0.1",
  "author": "pctrade (end4-pC) <https://github.com/pctrade/end4-pC>",
  "description": "Live audio spectrum with five styles — bars, mirror, aurora, ring and dots — driven by your own playback stream.",
  "license": "GPL-3.0-only",
  "official": false,
  "tags": [
    "visualizer",
    "audio",
    "spectrum",
    "shader",
    "desktop-widget",
    "mjw"
  ],
  "set": "MJW",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 460,
      "y": 620,
      "scale": 0.85
    },
    "icon": "equalizer",
    "label": "Visualizer"
  },
  "dependencies": {
    "commands": [],
    "optional": [
      "cava"
    ]
  },
  "files": [
    "content/Appearance.qml",
    "content/Backdrop.qml",
    "content/ColorUtils.qml",
    "content/Config.qml",
    "content/Directories.qml",
    "content/FadeLoader.qml",
    "content/GlobalStates.qml",
    "content/Icons.qml",
    "content/MprisController.qml",
    "content/ResizeHandler.qml",
    "content/Translation.qml",
    "content/VisualizerEngine.qml",
    "content/VisualizerShader.qml",
    "content/VisualizerWidget.qml",
    "content/Widget.qml",
    "content/WidgetBase.qml",
    "content/qmldir",
    "content/shaders/aurora.frag.qsb",
    "content/shaders/dots.frag.qsb",
    "content/shaders/mirror.frag.qsb",
    "content/shaders/ring.frag.qsb",
    "service/Main.qml"
  ],
  "metadata": {
    "settings": [
      {
        "key": "style",
        "type": "choice",
        "label": "Style",
        "group": "Visualizer",
        "default": "bars",
        "options": [
          {
            "value": "bars",
            "label": "Bars"
          },
          {
            "value": "mirror",
            "label": "Mirror"
          },
          {
            "value": "aurora",
            "label": "Aurora"
          },
          {
            "value": "ring",
            "label": "Ring"
          },
          {
            "value": "dots",
            "label": "Dots"
          }
        ]
      },
      {
        "key": "colorSource",
        "type": "choice",
        "label": "Colors from",
        "group": "Visualizer",
        "default": "theme",
        "options": [
          {
            "value": "theme",
            "label": "Desktop theme"
          },
          {
            "value": "cover",
            "label": "Album cover"
          }
        ]
      },
      {
        "key": "sensitivity",
        "type": "slider",
        "label": "Sensitivity",
        "group": "Visualizer",
        "default": 1.0,
        "min": 0.5,
        "max": 3.0,
        "step": 0.1,
        "decimals": 1
      }
    ]
  }
}
