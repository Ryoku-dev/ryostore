{
  "id": "awe-media",
  "name": "Media",
  "version": "1.0.1",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Now-playing card driven by playerctl (MPRIS): album art, scrubbable progress and transport controls.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "media",
    "player",
    "mpris",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/MediaWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 460,
      "y": 390,
      "scale": 0.8
    },
    "icon": "play_circle",
    "label": "Media"
  },
  "dependencies": {
    "commands": [
      "playerctl"
    ]
  }
}
