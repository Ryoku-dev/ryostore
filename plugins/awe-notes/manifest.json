{
  "id": "awe-notes",
  "name": "Notes",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Inline-editable sticky notes with colour tags, saved locally between sessions.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "notes",
    "memo",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/Store.qml",
    "content/NotesWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": []
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "sticky_note_2",
    "label": "Notes"
  },
  "dependencies": {
    "commands": [
      "mkdir"
    ]
  }
}
