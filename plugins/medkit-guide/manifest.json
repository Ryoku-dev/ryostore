{
  "id": "medkit-guide",
  "name": "MedKit Guide",
  "version": "1.0.0",
  "author": "Hatem <hatem@users.noreply.github.com>",
  "description": "Medicine guide for MedKit with OpenFDA prescribing details, interactions, warnings, and side effects.",
  "license": "MIT",
  "tags": ["bar-widget", "health", "medicine", "medkit"],
  "official": false,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "files": [
    "bin/fetch-medicine.py",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": ["glyph"],
    "network": ["api.fda.gov"]
  },
  "hosts": ["topbarGlyph"],
  "commands": ["bin/fetch-medicine.py"],
  "dependencies": {
    "commands": ["python3"]
  },
  "defaults": {
    "host": "topbarGlyph",
    "bar": { "section": "right" },
    "icon": "pill",
    "label": "MedGuide"
  },
  "panel": { "width": 480 },
  "metadata": {
    "settings": [
      {
        "key": "autoRefresh",
        "type": "toggle",
        "label": "Refresh OpenFDA details when the plugin starts",
        "group": "MedKit Guide",
        "default": true
      },
      {
        "key": "cacheDays",
        "type": "slider",
        "label": "Cache duration (days)",
        "group": "MedKit Guide",
        "default": 7,
        "min": 1,
        "max": 30,
        "step": 1,
        "decimals": 0
      }
    ]
  }
}
