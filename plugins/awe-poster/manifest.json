{
  "id": "awe-poster",
  "name": "Poster",
  "version": "1.0.1",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "A decorative image frame that masks a picture or GIF into a Material organic shape.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "image",
    "decorative",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/PosterWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 880,
      "y": 330,
      "scale": 0.8
    },
    "icon": "image",
    "label": "Poster"
  },
  "dependencies": {
    "commands": []
  }
}
