#!/usr/bin/env bash
# Backlight helper for the smart-brightness plugin. Argv only (R9): never
# interpolates settings into a shell string. Writes only under the state dir
# the service passes (R8).
#
#   brightness get
#   brightness set <percent>
#   brightness save <state-dir> [percent]   # optional explicit % avoids a get/set race
#   brightness restore <state-dir>
set -euo pipefail

cmd="${1:-}"

get_pct() {
  brightnessctl --class=backlight -m 2>/dev/null \
    | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }'
}

case "${cmd}" in
  get)
    get_pct
    ;;
  set)
    pct="${2:?percent required}"
    brightnessctl --class=backlight set "${pct}%" >/dev/null 2>&1 || true
    ;;
  save)
    dir="${2:?state dir required}"
    mkdir -p "${dir}"
    if [[ "${3:-}" =~ ^[0-9]+$ ]]; then
      pct="${3}"
    else
      pct="$(get_pct || true)"
    fi
    # Only remember a real pre-max level (same idea as SPO / fullscreen-maxbright).
    if [[ -n "${pct}" ]] && (( pct < 99 )); then
      printf '%s\n' "${pct}" > "${dir}/saved"
    fi
    ;;
  restore)
    dir="${2:?state dir required}"
    [[ -f "${dir}/saved" ]] || exit 0
    pct="$(tr -d '[:space:]' < "${dir}/saved" || true)"
    [[ -n "${pct}" ]] || exit 0
    brightnessctl --class=backlight set "${pct}%" >/dev/null 2>&1 || true
    ;;
  *)
    echo "Usage: $0 get|set <pct>|save <dir> [pct]|restore <dir>" >&2
    exit 2
    ;;
esac
