{
  "id": "nothing-dashboard",
  "name": "Nothing Battery",
  "version": "0.4.0",
  "author": "Ivan \u003c254410104+venchik111@users.noreply.github.com\u003e",
  "description": "A Nothing OS-inspired battery tile with a dotted charge readout.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": ["bin/status.py", "assets/preview-widget.png"],
  "capabilities": {
    "densities": [
      "compact",
      "full"
    ]
  },
  "defaults": {
    "host": "desktopWidget",
    "label": "Nothing Battery",
    "desktopWidget": { "bg": "none" }
  },
  "dependencies": {
    "commands": ["python3"]
  },
  "metadata": {
    "settings": []
  }
}
