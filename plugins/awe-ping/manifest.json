{
  "id": "awe-ping",
  "name": "Ping",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Live latency monitor with a jitter sparkline, pinging Cloudflare and Google DNS.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "network",
    "ping",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/PingWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 880,
      "y": 522,
      "scale": 0.8
    },
    "icon": "settings_ethernet",
    "label": "Ping"
  },
  "dependencies": {
    "commands": [
      "ping",
      "awk"
    ]
  }
}
