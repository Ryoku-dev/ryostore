{
  "id": "sugar-tracker",
  "name": "Sugar Tracker",
  "version": "1.0.1",
  "author": "Hatem <hatem@users.noreply.github.com>",
  "description": "Track daily sugar intake in grams from the QS Bar.",
  "license": "MIT",
  "tags": ["bar-widget", "health"],
  "official": false,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "files": [],
  "capabilities": {
    "densities": ["glyph", "full"]
  },
  "hosts": ["topbarGlyph"],
  "defaults": {
    "host": "topbarGlyph",
    "bar": { "section": "right" },
    "icon": "fork_spoon",
    "label": "Sugar"
  },
  "panel": { "width": 360 },
  "metadata": {
    "settings": [
      {
        "key": "dailyGoal",
        "type": "int",
        "label": "Daily sugar goal (g)",
        "group": "Sugar Tracker",
        "default": 25,
        "min": 1,
        "max": 200,
        "step": 1
      }
    ]
  }
}
