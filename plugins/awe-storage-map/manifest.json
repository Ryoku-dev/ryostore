{
  "id": "awe-storage-map",
  "name": "Storage Map",
  "version": "1.0.1",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Root filesystem usage with a segmented bar and a used and free breakdown, read from df.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "storage",
    "disk",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/StorageMapWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 1720,
      "y": 686,
      "scale": 0.8
    },
    "icon": "storage",
    "label": "Storage Map"
  },
  "dependencies": {
    "commands": [
      "df",
      "awk",
      "tr"
    ]
  }
}
