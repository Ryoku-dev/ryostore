{
  "id": "github-heatmap",
  "name": "GitHub Heatmap",
  "version": "0.8.0",
  "author": "safloresmo <safloresmo@gmail.com>",
  "description": "Your GitHub contribution calendar on the wallpaper: four designs, palettes that follow your theme, streaks and a glass card.",
  "license": "MIT",
  "official": false,
  "tags": [
    "github",
    "contributions",
    "heatmap",
    "calendar",
    "desktop-widget"
  ],
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "bin/gh-contrib",
    "assets/preview-widget.png",
    "assets/preview-github.png",
    "assets/preview-settings.png",
    "assets/preview-minimal.png"
  ],
  "capabilities": {
    "densities": [
      "compact",
      "full"
    ],
    "network": [
      "github.com"
    ],
    "colors": true,
    "glass": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true
    },
    "icon": "calendar_month",
    "label": "GitHub Heatmap"
  },
  "dependencies": {
    "commands": [
      "python3",
      "gh",
      "ryoku-plugins-place"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "username",
        "type": "text",
        "label": "GitHub username",
        "default": "",
        "placeholder": "octocat"
      },
      {
        "key": "design",
        "type": "choice",
        "style": "cycle",
        "label": "Design",
        "default": "github",
        "options": [
          {
            "value": "github",
            "label": "GitHub"
          },
          {
            "value": "blocks",
            "label": "Grid"
          },
          {
            "value": "minimal",
            "label": "Minimal"
          },
          {
            "value": "full",
            "label": "Full"
          }
        ]
      },
      {
        "key": "background",
        "type": "choice",
        "style": "cycle",
        "label": "Background",
        "default": "glass",
        "options": [
          {
            "value": "glass",
            "label": "Glass"
          },
          {
            "value": "paper",
            "label": "Paper"
          },
          {
            "value": "card",
            "label": "Solid"
          },
          {
            "value": "none",
            "label": "None"
          }
        ]
      }
    ]
  }
}
