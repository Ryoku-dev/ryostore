{
  "id": "awe-volume-brightness",
  "name": "Volume & Brightness",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Volume and screen-brightness sliders with mute, driven by wpctl and brightnessctl.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "audio",
    "brightness",
    "controls",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/VolumeBrightnessWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 1300,
      "y": 694,
      "scale": 0.8
    },
    "icon": "volume_up",
    "label": "Volume & Brightness"
  },
  "dependencies": {
    "commands": [
      "wpctl",
      "brightnessctl"
    ]
  }
}
