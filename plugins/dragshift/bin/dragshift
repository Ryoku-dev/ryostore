#!/usr/bin/env python3
"""dragshift - the one command the DragShift bar plugin runs.

Standard library only, so it works on whatever python3 pacman ships. It finds
the engine checkout (--engine DIR, default ~/.local/share/dragshift/engine), then runs
that checkout's own venv interpreter on dragshift_engine.py under `python -I`,
passing stdin/stdout through, forwarding SIGTERM/SIGINT/SIGHUP, and exiting with
its code. The child also dies if this process is SIGKILLed (PR_SET_PDEATHSIG),
so a cancelled job never keeps running unseen. That venv uses a uv-managed Python, so system Python upgrades
never break it. If the venv is missing it answers in the same one-line JSON the
engine uses, with the command that fixes it.

    dragshift [--engine DIR] [--output next|folder] COMMAND ARGS...
"""
import ctypes
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULT_ENGINE = "~/.local/share/dragshift/engine"


def answer(obj, code):
    print(json.dumps(obj, ensure_ascii=False), flush=True)
    sys.exit(code)


def main(argv):
    engine = os.environ.get("DRAGSHIFT_ENGINE") or DEFAULT_ENGINE
    if argv[:1] == ["--engine"]:
        if len(argv) < 2:
            answer({"ok": False, "error": "--engine needs a directory"}, 1)
        engine, argv = argv[1], argv[2:]
    if not argv:
        answer({"ok": False, "error": "No command given"}, 1)
    engine = Path(engine).expanduser().resolve()
    python = engine / ".venv" / "bin" / "python"
    if not os.access(python, os.X_OK):
        answer({"ok": False, "engine": str(engine),
                "error": f"DragShift engine is not set up at {engine}",
                "fix": f"{HERE.parent / 'engine' / 'setup.sh'} {engine}"}, 1)
    env = dict(os.environ, DRAGSHIFT_ENGINE=str(engine))
    script = str(HERE / "dragshift_engine.py")
    # -I: ignore PYTHON* env and cwd; -B: never write __pycache__ into the plugin folder (R8)
    sys.exit(run([str(python), "-I", "-B", script, *argv], env))


def _die_with_parent():
    """In the child, before exec: get SIGKILL when the launcher goes away."""
    try:
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass


def run(cmd, env):
    """Run the engine as a child, forward termination signals, return its exit code."""
    proc = subprocess.Popen(cmd, env=env, preexec_fn=_die_with_parent)

    def forward(sig, _frame):
        proc.send_signal(sig)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, forward)
    code = proc.wait()
    return 128 - code if code < 0 else code


if __name__ == "__main__":
    main(sys.argv[1:])
