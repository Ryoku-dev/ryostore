{
  "id": "mjw-media",
  "name": "Media",
  "version": "2.0.2",
  "author": "pctrade (end4-pC) <https://github.com/pctrade/end4-pC>",
  "description": "MPRIS player tile with cover art, waveform seekbar, controls and synced lyrics from lrclib — the illogical-impulse media widget.",
  "license": "GPL-3.0-only",
  "official": false,
  "tags": [
    "media",
    "player",
    "mpris",
    "lyrics",
    "desktop-widget",
    "mjw"
  ],
  "set": "MJW",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [
      "lrclib.net"
    ],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 880,
      "y": 110,
      "scale": 0.85
    },
    "icon": "music_note",
    "label": "Media"
  },
  "dependencies": {
    "commands": [
      "curl",
      "python3"
    ]
  },
  "files": [
    "bin/lyrics.py",
    "content/Appearance.qml",
    "content/Audio.qml",
    "content/Backdrop.qml",
    "content/ColorUtils.qml",
    "content/Config.qml",
    "content/Directories.qml",
    "content/FastBlurred.qml",
    "content/GlobalStates.qml",
    "content/Icons.qml",
    "content/Lyrics.qml",
    "content/LyricsService.qml",
    "content/MaterialLoadingIndicator.qml",
    "content/MaterialShape.qml",
    "content/MaterialShapeWrappedMaterialSymbol.qml",
    "content/MaterialSymbol.qml",
    "content/MediaWidget.qml",
    "content/MprisController.qml",
    "content/ResizeHandler.qml",
    "content/RippleButton.qml",
    "content/StyledImage.qml",
    "content/StyledRectangularShadow.qml",
    "content/StyledText.qml",
    "content/Translation.qml",
    "content/Widget.qml",
    "content/WidgetBase.qml",
    "content/qmldir",
    "content/shapes/LICENSE",
    "content/shapes/README.md",
    "content/shapes/ShapeCanvas.qml",
    "content/shapes/geometry/offset.js",
    "content/shapes/graphics/matrix.js",
    "content/shapes/material-shapes.js",
    "content/shapes/shapes/corner-rounding.js",
    "content/shapes/shapes/cubic.js",
    "content/shapes/shapes/feature-mapping.js",
    "content/shapes/shapes/feature.js",
    "content/shapes/shapes/float-mapping.js",
    "content/shapes/shapes/morph.js",
    "content/shapes/shapes/point.js",
    "content/shapes/shapes/polygon-measure.js",
    "content/shapes/shapes/rounded-corner.js",
    "content/shapes/shapes/rounded-polygon.js",
    "content/shapes/shapes/utils.js",
    "service/Main.qml"
  ],
  "metadata": {
    "settings": [
      {
        "key": "sizeMode",
        "type": "choice",
        "label": "Size",
        "group": "Media",
        "default": "1x2",
        "options": [
          {
            "value": "1x1",
            "label": "Compact"
          },
          {
            "value": "1x2",
            "label": "Standard"
          },
          {
            "value": "2x2",
            "label": "Large"
          }
        ]
      },
      {
        "key": "showControls",
        "type": "toggle",
        "label": "Playback controls",
        "group": "Media",
        "default": true
      },
      {
        "key": "showLyrics",
        "type": "toggle",
        "label": "Synced lyrics",
        "group": "Media",
        "default": false
      },
      {
        "key": "backgroundShape",
        "type": "choice",
        "label": "Card shape",
        "group": "Media",
        "default": "Cookie4Sided",
        "options": [
          {
            "value": "Cookie4Sided",
            "label": "Cookie"
          },
          {
            "value": "Squircle",
            "label": "Squircle"
          },
          {
            "value": "Pill",
            "label": "Pill"
          },
          {
            "value": "Circle",
            "label": "Circle"
          },
          {
            "value": "Arch",
            "label": "Arch"
          },
          {
            "value": "Leaf",
            "label": "Leaf"
          }
        ]
      }
    ]
  },
  "commands": [
    "bin/lyrics.py"
  ]
}
