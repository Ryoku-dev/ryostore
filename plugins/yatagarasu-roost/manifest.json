{
  "schema": 1,
  "id": "yatagarasu-roost",
  "category": "plugins",
  "version": "1.0.0",
  "destination": "ryoku/plugins/yatagarasu-roost",
  "name": "Yatagarasu Roost",
  "author": "0xSrcAura",
  "description": "The Kasugai crow herself, roosting on your desktop. Her eye wears the colour of the last notification \u2014 LOW cyan, MEDIUM emerald, HIGH amber, CRITICAL rose \u2014 fed by her own listener on the notification bus. The other half of Yatagarasu: the notification design is her voice; this is her.",
  "license": "GPL-3.0-or-later",
  "tags": [
    "desktop-widget",
    "crow",
    "notifications"
  ],
  "official": false,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "assets/preview-widget.png",
    "bin/monitor.py",
    "content/KasugaiCrow.qml"
  ],
  "capabilities": {
    "densities": [
      "compact",
      "full"
    ]
  },
  "dependencies": {
    "commands": [
      "python3",
      "dbus-monitor"
    ]
  },
  "hosts": [
    "desktopWidget"
  ],
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "notifications",
    "label": "Yatagarasu"
  }
}