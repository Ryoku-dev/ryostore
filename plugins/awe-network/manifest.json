{
  "id": "awe-network",
  "name": "Network",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Live Wi-Fi status, local IP, and up/down throughput with an activity sparkline.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "network",
    "wifi",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/NetworkWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [
      "1.1.1.1"
    ]
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "wifi",
    "label": "Network"
  },
  "dependencies": {
    "commands": [
      "nmcli",
      "ip"
    ]
  }
}
