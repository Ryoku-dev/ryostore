#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Radio Atlas requires XDG_RUNTIME_DIR}"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
runtime_dir="${RADIO_ATLAS_RUNTIME_DIR:-$XDG_RUNTIME_DIR/ryoku-radio-atlas}"
proxy_socket="$runtime_dir/proxy.sock"
proxy_pid=""
sandbox_pid=""
proxy_arguments=("$proxy_socket")
allow_fake_ip=$("$script_dir/radio-state" get | jq -r '.allowFakeIp // false')
if [[ $allow_fake_ip == true ]]; then
  proxy_arguments+=(--allow-fake-ip)
fi

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  [[ -z $sandbox_pid ]] || kill "$sandbox_pid" 2>/dev/null || true
  [[ -z $sandbox_pid ]] || wait "$sandbox_pid" 2>/dev/null || true
  [[ -z $proxy_pid ]] || kill "$proxy_pid" 2>/dev/null || true
  [[ -z $proxy_pid ]] || wait "$proxy_pid" 2>/dev/null || true
  rm -f "$proxy_socket"
  exit "$exit_code"
}
trap cleanup EXIT INT TERM

rm -f "$proxy_socket"
setpriv --pdeathsig TERM python3 "$script_dir/radio-proxy" "${proxy_arguments[@]}" \
  > "$runtime_dir/proxy.log" 2>&1 &
proxy_pid=$!
for _ in $(seq 1 100); do
  [[ -S $proxy_socket ]] && break
  kill -0 "$proxy_pid" 2>/dev/null || break
  sleep 0.02
done
[[ -S $proxy_socket ]] || exit 4

# The MPRIS bridge needs python-dbus; without it the player would still work,
# so drop the bridge rather than losing playback, and say so.
bridge_arguments=()
if python3 -c 'import dbus' >/dev/null 2>&1; then
  bridge_arguments=(
    setpriv --pdeathsig TERM /usr/bin/python3 "$script_dir/radio-mpris" "$runtime_dir/mpv.sock" --
  )
else
  echo "radio-session: python-dbus is not installed; Radio Atlas will not appear in media controls" >&2
fi

RADIO_ATLAS_ALLOW_FAKE_IP="$allow_fake_ip" "${bridge_arguments[@]}" \
  bwrap --unshare-net --unshare-pid --die-with-parent --cap-add CAP_NET_ADMIN \
  --bind / / --dev-bind /dev /dev -- \
  /usr/bin/bash --noprofile --norc -c '
    set -e
    ip link set lo up
    exec setpriv --inh-caps=-net_admin --ambient-caps=-net_admin "$@"
  ' radio-atlas-network "$script_dir/radio-sandbox" "$runtime_dir" "$@" &
sandbox_pid=$!
wait "$sandbox_pid"
