#!/usr/bin/env node
'use strict';

const PT = require('../lib/praytimes.js');
const C = require('../lib/cities.js');
const H = require('../lib/hijri.js');

const keys = ['fajr', 'sunrise', 'dhuhr', 'asr', 'maghrib', 'isha'];
const labels = {
    fajr: 'Fajr',
    sunrise: 'Sunrise',
    dhuhr: 'Dhuhr',
    asr: 'Asr',
    maghrib: 'Maghrib',
    isha: 'Isha'
};

const USAGE = `usage: prayer-times [--json|--text|--waybar] [--city <id>|auto]
                   [--date YYYY-MM-DD] [--method <id>] [--high-lat <rule>] [--24]

  --json      default: one JSON object with every time
  --text      one prayer per line
  --waybar    waybar module JSON (text + tooltip + class)
  --city      preset id, or auto/--auto to detect from the timezone (see --cities)
  --cities    list every preset id
  --date      defaults to today in that city's timezone
  --method    override the city's method: ${Object.keys(PT.METHODS).join(', ')}
  --high-lat  none, middle, seventh or angle (fills missing twilight above ~48 deg)
  --24        print a 24-hour clock
  -h, --help  this text
`;

function fail(message) {
    console.error(`prayer-times: ${message}`);
    process.exit(1);
}

// Everything below works on the city's wall clock, not this machine's: a preset in
// another country still prints that country's times.
function zoneParts(timeZone, instant) {
    const parts = new Intl.DateTimeFormat('en-US', {
        timeZone, hour12: false,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit'
    }).formatToParts(instant);
    const get = (type) => Number(parts.find((p) => p.type === type).value);
    return { y: get('year'), m: get('month'), d: get('day'), hh: get('hour') % 24, mm: get('minute') };
}

function zoneNow(timeZone) {
    const p = zoneParts(timeZone, new Date());
    const pad = (n) => String(n).padStart(2, '0');
    return {
        iso: `${p.y}-${pad(p.m)}-${pad(p.d)}`,
        minutes: p.hh * 60 + p.mm
    };
}

function zoneOffsetHours(timeZone, y, m, d) {
    const utcNoon = Date.UTC(y, m - 1, d, 12);
    const p = zoneParts(timeZone, new Date(utcNoon));
    return (Date.UTC(p.y, p.m - 1, p.d, p.hh, p.mm) - utcNoon) / 3600000;
}

function isoDate(date) {
    const pad = (n) => String(n).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

function parseDate(value) {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
    if (!match)
        fail('date must use YYYY-MM-DD');
    const y = Number(match[1]);
    const m = Number(match[2]);
    const d = Number(match[3]);
    const date = new Date(y, m - 1, d, 12);
    if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d)
        fail('invalid date');
    return date;
}

let mode = 'json';
let cityId = null;
let clock24 = false;
let dateValue = null;
let methodOverride = null;
let highLat = 'none';

for (let i = 2; i < process.argv.length; ++i) {
    const arg = process.argv[i];
    if (arg === '--json' || arg === '--text' || arg === '--waybar') {
        mode = arg.substring(2);
    } else if (arg === '--help' || arg === '-h') {
        process.stdout.write(USAGE);
        process.exit(0);
    } else if (arg === '--cities') {
        console.log(C.ids().join('\n'));
        process.exit(0);
    } else if (arg === 'auto' || arg === '--auto') {
        cityId = null;
    } else if (arg === '--24') {
        clock24 = true;
    } else if (arg === '--method') {
        if (++i >= process.argv.length || process.argv[i].startsWith('-'))
            fail('--method requires an id');
        methodOverride = process.argv[i];
        if (!PT.METHODS[methodOverride])
            fail(`unknown method: ${methodOverride}`);
    } else if (arg === '--high-lat') {
        if (++i >= process.argv.length || process.argv[i].startsWith('-'))
            fail('--high-lat requires a rule');
        highLat = process.argv[i];
        if (!['none', 'middle', 'seventh', 'angle'].includes(highLat))
            fail(`unknown high-latitude rule: ${highLat}`);
    } else if (arg === '--city') {
        if (++i >= process.argv.length || process.argv[i].startsWith('-'))
            fail('--city requires an id');
        cityId = process.argv[i] === 'auto' ? null : process.argv[i];
    } else if (arg === '--date') {
        if (++i >= process.argv.length || process.argv[i].startsWith('-'))
            fail('--date requires YYYY-MM-DD');
        dateValue = process.argv[i];
    } else {
        fail(`unknown option: ${arg}`);
    }
}

const guessed = cityId === null ? C.guess(Intl.DateTimeFormat().resolvedOptions().timeZone) : null;
const city = cityId === null ? (guessed && guessed.city) : C.byId(cityId);
if (!city)
    fail(cityId === null ? 'no preset city for this timezone; pass --city <id> (see --cities)'
                         : `unknown city: ${cityId}`);

const now = zoneNow(city.tz);
const date = parseDate(dateValue || now.iso);

function calculate(day) {
    return PT.times({
        year: day.getFullYear(),
        month: day.getMonth() + 1,
        day: day.getDate(),
        lat: city.lat,
        lon: city.lon,
        tzHours: zoneOffsetHours(city.tz, day.getFullYear(), day.getMonth() + 1, day.getDate()),
        method: methodOverride || city.method,
        asr: 1,
        highLat,
        offsets: { fajr: 0, sunrise: 0, dhuhr: 0, asr: 0, maghrib: 0, isha: 0 }
    });
}

const times = calculate(date);
const formatted = {};
for (const key of keys)
    formatted[key] = PT.fmt(times ? times[key] : null, clock24);

if (mode === 'json') {
    const hijri = H.toHijri(date.getFullYear(), date.getMonth() + 1, date.getDate(), 0);
    console.log(JSON.stringify({
        city: city.id,
        name: `${city.name}, ${city.country}`,
        date: isoDate(date),
        hijri: hijri ? `${hijri.d} ${H.monthName(hijri.m)} ${hijri.y}` : null,
        method: methodOverride || city.method,
        highLat,
        times: formatted
    }));
} else if (mode === 'text') {
    for (const key of keys)
        console.log(`${labels[key].padEnd(8)} ${formatted[key]}`);
} else {
    // waybar module: the next prayer on the city's clock, not this machine's
    let next = null;
    if (now.iso === isoDate(date)) {
        for (const key of keys) {
            if (!times || times[key] === null || times[key] < 0 || times[key] >= 1440)
                continue;                       // a high-latitude fallback can leave the day
            if (times[key] >= now.minutes) {
                next = { key, at: times[key] };
                break;
            }
        }
        if (!next) {
            const tomorrow = new Date(date.getFullYear(), date.getMonth(), date.getDate() + 1, 12);
            const tomorrowTimes = calculate(tomorrow);
            for (const key of keys) {
                if (tomorrowTimes && tomorrowTimes[key] !== null) {
                    next = { key, at: tomorrowTimes[key] };
                    break;
                }
            }
        }
    } else {
        for (const key of keys) {
            if (times && times[key] !== null) {
                next = { key, at: times[key] };
                break;
            }
        }
    }
    if (!next)
        next = { key: 'fajr', at: null };
    const icon = next.key === 'fajr' || next.key === 'isha' ? '☾' : '☀';
    const tooltip = [`${city.name}, ${city.country} · ${isoDate(date)}`]
        .concat(keys.map((key) => `${labels[key]} ${formatted[key]}`))
        .join('\n');
    console.log(JSON.stringify({
        text: `${icon} ${labels[next.key]} ${PT.fmt(next.at, clock24)}`,
        tooltip,
        class: 'prayer'
    }));
}
