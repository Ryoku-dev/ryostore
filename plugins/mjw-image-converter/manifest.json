{
  "id": "mjw-image-converter",
  "name": "Image Converter",
  "version": "2.0.1",
  "author": "pctrade (end4-pC) <https://github.com/pctrade/end4-pC>",
  "description": "Drop images on the tile to convert them (png/jpg/webp/avif/bmp/tiff) or merge a stack into one PDF, beside the source.",
  "license": "GPL-3.0-only",
  "official": false,
  "tags": [
    "image",
    "converter",
    "utility",
    "pdf",
    "desktop-widget",
    "mjw"
  ],
  "set": "MJW",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 1300,
      "y": 860,
      "scale": 0.85
    },
    "icon": "autorenew",
    "label": "Image Converter"
  },
  "dependencies": {
    "commands": [
      "ffmpeg",
      "convert"
    ]
  },
  "files": [
    "content/Appearance.qml",
    "content/Backdrop.qml",
    "content/ColorUtils.qml",
    "content/Config.qml",
    "content/Directories.qml",
    "content/FastBlurred.qml",
    "content/GlobalStates.qml",
    "content/Icons.qml",
    "content/ImageConverterWidget.qml",
    "content/MaterialLoadingIndicator.qml",
    "content/MaterialShape.qml",
    "content/MaterialSymbol.qml",
    "content/ResizeHandler.qml",
    "content/StyledComboBox.qml",
    "content/StyledDropShadow.qml",
    "content/StyledImage.qml",
    "content/StyledListView.qml",
    "content/StyledRectangularShadow.qml",
    "content/StyledScrollBar.qml",
    "content/StyledText.qml",
    "content/Translation.qml",
    "content/Widget.qml",
    "content/WidgetBase.qml",
    "content/qmldir",
    "content/shapes/LICENSE",
    "content/shapes/README.md",
    "content/shapes/ShapeCanvas.qml",
    "content/shapes/geometry/offset.js",
    "content/shapes/graphics/matrix.js",
    "content/shapes/material-shapes.js",
    "content/shapes/shapes/corner-rounding.js",
    "content/shapes/shapes/cubic.js",
    "content/shapes/shapes/feature-mapping.js",
    "content/shapes/shapes/feature.js",
    "content/shapes/shapes/float-mapping.js",
    "content/shapes/shapes/morph.js",
    "content/shapes/shapes/point.js",
    "content/shapes/shapes/polygon-measure.js",
    "content/shapes/shapes/rounded-corner.js",
    "content/shapes/shapes/rounded-polygon.js",
    "content/shapes/shapes/utils.js",
    "service/Main.qml"
  ]
}
