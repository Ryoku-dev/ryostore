{
  "id": "awe-git-dashboard",
  "name": "Git Dashboard",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Shows the branch, dirty-file count, and last commit of the git repository in your home directory.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "git",
    "developer",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/GitDashboardWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ]
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "code",
    "label": "Git Dashboard"
  },
  "dependencies": {
    "commands": [
      "git"
    ]
  }
}
