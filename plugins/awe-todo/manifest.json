{
  "id": "awe-todo",
  "name": "Todo",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Desktop task list with a progress bar and per-task completion, saved locally.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "todo",
    "tasks",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/Store.qml",
    "content/TodoWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": []
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none"
    },
    "icon": "check_square",
    "label": "Todo"
  },
  "dependencies": {
    "commands": [
      "mkdir"
    ]
  }
}
