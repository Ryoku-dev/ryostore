{
  "id": "awe-resource-wheel",
  "name": "Resource Wheel",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Concentric CPU, RAM, disk and temperature gauge with a live legend, polled from /proc and the filesystem.",
  "license": "BSL-1.0",
  "official": false,
  "tags": [
    "system",
    "monitor",
    "desktop-widget",
    "awe"
  ],
  "set": "Awe",
  "hosts": [
    "desktopWidget"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/qmldir",
    "content/Theme.qml",
    "content/ResourceWheelWidget.qml",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "compact"
    ],
    "network": [],
    "colors": true
  },
  "defaults": {
    "host": "desktopWidget",
    "desktopWidget": {
      "bg": "none",
      "autoEnable": true,
      "x": 1300,
      "y": 326,
      "scale": 0.8
    },
    "icon": "speed",
    "label": "Resource Wheel"
  },
  "dependencies": {
    "commands": [
      "grep",
      "awk",
      "free",
      "df",
      "cat"
    ]
  }
}
